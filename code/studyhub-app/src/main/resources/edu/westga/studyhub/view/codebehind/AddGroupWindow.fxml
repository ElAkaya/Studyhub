<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="6" prefWidth="520" prefHeight="700" minWidth="460" minHeight="650"
      stylesheets="@studyhub.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.westga.studyhub.view.codebehind.AddGroupWindow">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="Create a study group" styleClass="title"/>
    <Label text="All fields are required. Groups are saved for this session only." wrapText="true" styleClass="subtitle"/>
    <Label text="Group name" labelFor="$groupName"/>
    <TextField fx:id="groupName" promptText="For example, Monday review crew"/>
    <Label text="Course" labelFor="$courseSelector"/>
    <ComboBox fx:id="courseSelector" promptText="Select a catalog course" maxWidth="Infinity"/>
    <Label text="Description" labelFor="$description"/>
    <TextArea fx:id="description" promptText="What will your group study?" wrapText="true" prefRowCount="3" VBox.vgrow="ALWAYS"/>
    <Label text="Meeting time" labelFor="$meetingTime"/>
    <TextField fx:id="meetingTime" promptText="For example, Mondays at 3 PM"/>
    <Label text="Location" labelFor="$meetingLocation"/>
    <TextField fx:id="meetingLocation" promptText="Room, library, or online meeting information"/>
    <Label text="Maximum members" labelFor="$capacity"/>
    <TextField fx:id="capacity" promptText="Positive whole number, for example 5"/>
    <Label fx:id="errorMessage" wrapText="true" styleClass="error"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" onAction="#cancel" cancelButton="true"/>
        <Button fx:id="saveButton" text="Save group" onAction="#addGroup" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
