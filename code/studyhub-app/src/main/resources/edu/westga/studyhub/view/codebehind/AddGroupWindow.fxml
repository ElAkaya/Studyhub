<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane fx:id="guiPane" minHeight="99.0" minWidth="160.0" prefHeight="170.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.studyhub.view.codebehind.AddGroupWindow">
   <children>
      <Label layoutX="14.0" layoutY="18.0" text="Group Name" />
      <Label layoutX="14.0" layoutY="48.0" text="Course Code" />
      <Label layoutX="14.0" layoutY="78.0" text="Capacity" />
      <TextField fx:id="groupName" layoutX="115.0" layoutY="14.0" />
      <TextField fx:id="courseCode" layoutX="115.0" layoutY="44.0" />
      <TextField fx:id="capacity" layoutX="115.0" layoutY="74.0" />
      <Button layoutX="80.0" layoutY="120.0" mnemonicParsing="false" onAction="#addGroup" text="Submit" />
      <Button layoutX="160.0" layoutY="120.0" mnemonicParsing="false" onAction="#cancel" text="Cancel" />
   </children>
</AnchorPane>
