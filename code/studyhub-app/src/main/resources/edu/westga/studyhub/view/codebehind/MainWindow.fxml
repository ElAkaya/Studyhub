<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="16" prefWidth="740" prefHeight="550" minWidth="600" minHeight="430"
      stylesheets="@studyhub.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.westga.studyhub.view.codebehind.MainWindow">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label text="StudyHub" styleClass="title"/>
    <Label text="Find your next study session" styleClass="subtitle"/>
    <Label text="Demonstration semester catalog · Local session only · Groups reset when you close the app"
           wrapText="true" styleClass="notice"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Course" labelFor="$courseSelector"/>
        <ComboBox fx:id="courseSelector" promptText="All courses" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="showAllButton" text="Show all" onAction="#showAll"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search code" labelFor="$courseSearch"/>
        <TextField fx:id="courseSearch" promptText="Enter a course code, such as CS101 or CS"
                   HBox.hgrow="ALWAYS"/>
    </HBox>
    <Label fx:id="resultCount" styleClass="subtitle"/>
    <ListView fx:id="studyGroups" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="deleteButton" text="Delete group" onAction="#removeGroup"/>
        <Button fx:id="detailsButton" text="View details" onAction="#viewDetails"/>
        <Button fx:id="createButton" text="Create group" onAction="#addGroup" styleClass="primary"/>
    </HBox>
</VBox>
